# ─── InfoMatt360 Mobile API ───
# Copiar este archivo como .env y ajustar los valores

# Puerto del servidor
PORT=3000

# JWT - CAMBIAR EN PRODUCCION
JWT_SECRET=cambiar_este_secreto_en_produccion_min_32_chars
JWT_REFRESH_SECRET=cambiar_este_refresh_secret_en_produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos SQLite
DB_PATH=./data/infomatt360.db

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Entorno
NODE_ENV=development
